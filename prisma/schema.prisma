generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String         @id @default(cuid())
  username       String         @unique
  passwordHash   String
  fullName       String
  department     String?
  role           String
  organizationId String?
  organization   Organization?  @relation(fields: [organizationId], references: [id])
  plantId        String?
  plant          Plant?         @relation(fields: [plantId], references: [id])
  categoryId     String?
  category       Category?      @relation(fields: [categoryId], references: [id])
  categories     UserCategory[]
  signature      Signature?
  profilePhoto   ProfilePhoto?
  active         Boolean        @default(true)
  lastSeenAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  claimedWorks                CmWork[]                 @relation("Claimant")
  closedWorks                 CmWork[]                 @relation("EngineerReviewer")
  auditEvents                 AuditEvent[]
  announcements               Announcement[]           @relation("AnnouncementAuthor")
  notifications               UserNotification[]       @relation("NotificationRecipient")
  siteAdminPermissions        SiteAdminPermission[]    @relation("SiteAdminPermissionUser")
  grantedSiteAdminPermissions SiteAdminPermission[]    @relation("SiteAdminPermissionGrantedBy")
  userPermissionOverrides     UserPermissionOverride[] @relation("UserPermissionOverrideUser")
  grantedUserPermissions      UserPermissionOverride[] @relation("UserPermissionOverrideGrantedBy")
  grantedRolePermissions      RolePermissionOverride[] @relation("RolePermissionOverrideGrantedBy")
  inventoryScopes             UserInventoryScope[]
  stockMovements              StockMovement[]
  sparePartReceives           SparePartReceive[]
  requestedStoreIssues        SparePartIssue[]         @relation("StoreIssueRequester")
  engineerStoreIssues         SparePartIssue[]         @relation("StoreIssueEngineer")
  officerStoreIssues          SparePartIssue[]         @relation("StoreIssueOfficer")
  confirmedPmPlans            PmPlan[]                 @relation("PmPlanConfirmedBy")
  canceledPmPlans             PmPlan[]                 @relation("PmPlanCanceledBy")
  rescheduledPmPlans          PmPlan[]                 @relation("PmPlanRescheduledBy")
  backdatedPmPlans            PmPlan[]                 @relation("PmPlanBackdatedBy")
  completedPmWorks            PmWork[]                 @relation("PmWorkCompletedBy")
  canceledPmWorks             PmWork[]                 @relation("PmWorkCanceledBy")
  correctedPmWorks            PmWork[]                 @relation("PmWorkCorrectedBy")
  pmWorkAssignments           PmWorkAssignee[]         @relation("PmWorkAssigneeUser")
  assignedPmWorks             PmWorkAssignee[]         @relation("PmWorkAssignedBy")

  @@index([lastSeenAt])
}

model UserInventoryScope {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemKind               String
  responsibilityEnabled Boolean  @default(false)
  approvalEnabled       Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([userId, itemKind])
  @@index([itemKind, responsibilityEnabled])
  @@index([itemKind, approvalEnabled])
}

model Organization {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plants                  Plant[]
  users                   User[]
  categories              Category[]
  works                   CmWork[]
  lineDestinations        LineDestination[]
  announcements           Announcement[]
  feedback                PublicFeedback[]
  profiles                OrganizationProfile[]
  auditEvents             AuditEvent[]
  lineGroupDiscoveries    LineGroupDiscovery[]
  lineDailyReportSettings LineDailyReportSetting[]
  storeCategories         StoreCategory[]
  stores                  Store[]
  sparePartCategories     SparePartCategory[]
  sparePartMaterialGroups SparePartMaterialGroup[]
  sparePartTypes          SparePartType[]
  spareParts              SparePart[]
  storeApplicableZones    StoreApplicableZone[]
  storeStocks             StoreStock[]
  stockMovements          StockMovement[]
  sparePartReceives       SparePartReceive[]
  sparePartIssues         SparePartIssue[]
  rolePermissionOverrides RolePermissionOverride[]
  pmGroups                PmGroup[]
  pmPlans                 PmPlan[]

  @@index([active])
}

model Plant {
  id                              String       @id @default(cuid())
  organizationId                  String
  organization                    Organization @relation(fields: [organizationId], references: [id])
  code                            String
  inventoryCode                   String?      @unique
  publicStoreIssueEnabled         Boolean      @default(false)
  publicStoreIssueContactRequired Boolean      @default(false)
  name                            String
  maxUsers                        Int?
  maxWorkRequests                 Int?
  active                          Boolean      @default(true)
  createdAt                       DateTime     @default(now())
  updatedAt                       DateTime     @updatedAt

  users                   User[]
  categories              Category[]
  zones                   Zone[]
  works                   CmWork[]
  feedback                PublicFeedback[]
  auditEvents             AuditEvent[]
  siteAdminPermissions    SiteAdminPermission[]
  lineDestinations        LineDestination[]
  lineDailyReportSettings LineDailyReportSetting[]
  profile                 PlantProfile?
  slaSetting              SlaSetting?
  systemSetting           SystemSetting?
  storeCategories         StoreCategory[]
  stores                  Store[]
  sparePartCategories     SparePartCategory[]
  sparePartMaterialGroups SparePartMaterialGroup[]
  sparePartTypes          SparePartType[]
  spareParts              SparePart[]
  storeApplicableZones    StoreApplicableZone[]
  storeStocks             StoreStock[]
  stockMovements          StockMovement[]
  sparePartReceives       SparePartReceive[]
  sparePartIssues         SparePartIssue[]
  sparePartSequence       SparePartSequence?
  storeIssueSequences     StoreIssueSequence[]
  assetClasses            AssetClass[]
  assetTypes              AssetType[]
  assetFamilies           AssetFamily[]
  assets                  Asset[]
  assetSequences          AssetSequence[]
  assetQrSetting          AssetQrSetting?
  pmGroups                PmGroup[]
  pmPlans                 PmPlan[]

  @@unique([organizationId, code])
  @@unique([organizationId, name])
  @@unique([id, organizationId])
  @@index([organizationId, active])
}

model SiteAdminPermission {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation("SiteAdminPermissionUser", fields: [userId], references: [id], onDelete: Cascade)
  plantId       String
  plant         Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)
  permissionKey String
  enabled       Boolean  @default(false)
  grantedById   String?
  grantedBy     User?    @relation("SiteAdminPermissionGrantedBy", fields: [grantedById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, plantId, permissionKey])
  @@index([plantId, permissionKey, enabled])
  @@index([grantedById])
}

model RolePermissionOverride {
  id             String        @id @default(cuid())
  scopeKey       String
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String
  permissionKey  String
  decision       String
  grantedById    String?
  grantedBy      User?         @relation("RolePermissionOverrideGrantedBy", fields: [grantedById], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([scopeKey, role, permissionKey])
  @@index([organizationId, role])
  @@index([role, permissionKey])
}

model UserPermissionOverride {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation("UserPermissionOverrideUser", fields: [userId], references: [id], onDelete: Cascade)
  permissionKey String
  decision      String
  grantedById   String?
  grantedBy     User?    @relation("UserPermissionOverrideGrantedBy", fields: [grantedById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, permissionKey])
  @@index([permissionKey, decision])
  @@index([grantedById])
}

model Signature {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  fileName    String
  mimeType    String
  fileSize    Int
  storagePath String
  uploadedAt  DateTime @default(now())
}

model ProfilePhoto {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  fileName    String
  mimeType    String
  fileSize    Int
  storagePath String
  checksum    String
  uploadedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Category {
  id             String        @id @default(cuid())
  name           String
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  plantId        String?
  plant          Plant?        @relation(fields: [plantId], references: [id])
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  users            User[]
  userCategories   UserCategory[]
  works            CmWork[]
  lineDestinations LineDestination[]

  @@unique([plantId, name])
  @@index([active])
  @@index([organizationId, active])
  @@index([plantId, active])
}

model UserCategory {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, categoryId])
  @@index([categoryId])
}

model Zone {
  id        String   @id @default(cuid())
  name      String
  plantId   String?
  plant     Plant?   @relation(fields: [plantId], references: [id])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  works                CmWork[]
  storeApplicableZones StoreApplicableZone[]
  sparePartIssueItems  SparePartIssueItem[]
  assets               Asset[]

  @@unique([plantId, name])
  @@index([active])
  @@index([plantId, active])
}

model CmWork {
  id                  String        @id @default(cuid())
  number              String        @unique
  submissionKey       String?       @unique
  requesterName       String
  requesterDepartment String
  organizationId      String?
  organization        Organization? @relation(fields: [organizationId], references: [id])
  plantId             String?
  plant               Plant?        @relation(fields: [plantId], references: [id])
  categoryId          String
  category            Category      @relation(fields: [categoryId], references: [id])
  zoneId              String
  zone                Zone          @relation(fields: [zoneId], references: [id])
  machineName         String
  assetId             String?
  asset               Asset?        @relation(fields: [assetId], references: [id], onDelete: SetNull)
  assetCodeSnapshot   String?
  assetNameSnapshot   String?
  problemTitle        String
  problemDetail       String
  urgency             String
  status              String        @default("NEW")
  claimantId          String?
  claimant            User?         @relation("Claimant", fields: [claimantId], references: [id])
  rootCause           String?
  correctiveAction    String?
  workNote            String?
  engineerNote        String?
  canceledReason      String?
  releaseReason       String?
  returnedReason      String?
  createdAt           DateTime      @default(now())
  claimedAt           DateTime?
  inProgressAt        DateTime?
  waitingToCloseAt    DateTime?
  closedAt            DateTime?
  canceledAt          DateTime?
  reviewerId          String?
  reviewer            User?         @relation("EngineerReviewer", fields: [reviewerId], references: [id])
  originatingPmWorkId String?       @unique
  originatingPmWork   PmWork?       @relation(fields: [originatingPmWorkId], references: [id], onDelete: Restrict)

  statusHistory   StatusHistory[]
  auditEvents     AuditEvent[]
  sparePartIssues SparePartIssue[]

  @@index([assetId])
}

model CmNumberSequence {
  yearMonth  String   @id
  lastNumber Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PmGroup {
  id             String                @id @default(cuid())
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plantId        String
  plant          Plant                 @relation(fields: [plantId, organizationId], references: [id, organizationId], onDelete: Restrict)
  code           String
  name           String
  active         Boolean               @default(true)
  firstUsedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  assets         PmGroupAsset[]
  snapshots      PmPlanGroupSnapshot[]
  draftPlans     PmPlanDraftGroup[]

  @@unique([plantId, code])
  @@unique([id, plantId])
  @@index([organizationId, plantId, active])
}

model PmGroupAsset {
  id        String   @id @default(cuid())
  plantId   String
  pmGroupId String
  pmGroup   PmGroup  @relation(fields: [pmGroupId, plantId], references: [id, plantId], onDelete: Cascade)
  assetId   String
  asset     Asset    @relation(fields: [assetId, plantId], references: [id, plantId], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@unique([pmGroupId, assetId])
  @@index([assetId, plantId])
}

model PmPlanSequence {
  id              String   @id @default(cuid())
  siteCodeSegment String
  creationDateKey String
  lastNumber      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([siteCodeSegment, creationDateKey])
}

model PmPlan {
  id                     String                @id @default(cuid())
  organizationId         String
  organization           Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plantId                String
  plant                  Plant                 @relation(fields: [plantId, organizationId], references: [id, organizationId], onDelete: Restrict)
  number                 String?               @unique
  creationDateKey        String?
  plannedDateKey         String
  status                 String                @default("DRAFT")
  lastWorkSequence       Int                   @default(0)
  submissionKey          String?               @unique
  confirmedAt            DateTime?
  confirmedById          String?
  confirmedBy            User?                 @relation("PmPlanConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  canceledAt             DateTime?
  canceledById           String?
  canceledBy             User?                 @relation("PmPlanCanceledBy", fields: [canceledById], references: [id], onDelete: Restrict)
  cancellationReason     String?
  rescheduledAt          DateTime?
  rescheduledById        String?
  rescheduledBy          User?                 @relation("PmPlanRescheduledBy", fields: [rescheduledById], references: [id], onDelete: Restrict)
  previousPlannedDateKey String?
  rescheduleReason       String?
  backdatedAt            DateTime?
  backdatedById          String?
  backdatedBy            User?                 @relation("PmPlanBackdatedBy", fields: [backdatedById], references: [id], onDelete: Restrict)
  backdateReason         String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  draftGroups            PmPlanDraftGroup[]
  groupSnapshots         PmPlanGroupSnapshot[]
  works                  PmWork[]

  @@index([organizationId, plantId, plannedDateKey])
  @@unique([id, plantId])
  @@index([plantId, status, plannedDateKey])
}

model PmPlanDraftGroup {
  id        String   @id @default(cuid())
  plantId   String
  pmPlanId  String
  pmPlan    PmPlan   @relation(fields: [pmPlanId, plantId], references: [id, plantId], onDelete: Cascade)
  pmGroupId String
  pmGroup   PmGroup  @relation(fields: [pmGroupId, plantId], references: [id, plantId], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@unique([pmPlanId, pmGroupId])
  @@index([pmGroupId])
}

model PmPlanGroupSnapshot {
  id              String              @id @default(cuid())
  plantId         String
  pmPlanId        String
  pmPlan          PmPlan              @relation(fields: [pmPlanId, plantId], references: [id, plantId], onDelete: Restrict)
  sourcePmGroupId String
  sourcePmGroup   PmGroup             @relation(fields: [sourcePmGroupId, plantId], references: [id, plantId], onDelete: Restrict)
  codeSnapshot    String
  nameSnapshot    String
  createdAt       DateTime            @default(now())
  workSources     PmWorkSourceGroup[]

  @@unique([pmPlanId, sourcePmGroupId])
  @@unique([id, pmPlanId])
  @@index([sourcePmGroupId])
}

model PmWork {
  id                     String              @id @default(cuid())
  plantId                String
  pmPlanId               String
  pmPlan                 PmPlan              @relation(fields: [pmPlanId, plantId], references: [id, plantId], onDelete: Restrict)
  assetId                String
  asset                  Asset               @relation(fields: [assetId, plantId], references: [id, plantId], onDelete: Restrict)
  assetCodeSnapshot      String?
  assetNameSnapshot      String
  number                 String              @unique
  status                 String              @default("PLANNED")
  result                 String?
  resultNote             String?
  startedAt              DateTime?
  completedAt            DateTime?
  completedById          String?
  completedBy            User?               @relation("PmWorkCompletedBy", fields: [completedById], references: [id], onDelete: Restrict)
  canceledAt             DateTime?
  canceledById           String?
  canceledBy             User?               @relation("PmWorkCanceledBy", fields: [canceledById], references: [id], onDelete: Restrict)
  cancellationReason     String?
  correctedAt            DateTime?
  correctedById          String?
  correctedBy            User?               @relation("PmWorkCorrectedBy", fields: [correctedById], references: [id], onDelete: Restrict)
  correctionReason       String?
  addedAfterConfirmation Boolean             @default(false)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  sourceGroups           PmWorkSourceGroup[]
  assignees              PmWorkAssignee[]
  originatingCmWork      CmWork?

  @@unique([pmPlanId, assetId])
  @@unique([id, pmPlanId])
  @@index([assetId, status])
  @@index([pmPlanId, status])
}

model PmWorkSourceGroup {
  id                    String              @id @default(cuid())
  pmWorkId              String
  pmPlanId              String
  pmWork                PmWork              @relation(fields: [pmWorkId, pmPlanId], references: [id, pmPlanId], onDelete: Restrict)
  pmPlanGroupSnapshotId String
  pmPlanGroupSnapshot   PmPlanGroupSnapshot @relation(fields: [pmPlanGroupSnapshotId, pmPlanId], references: [id, pmPlanId], onDelete: Restrict)
  createdAt             DateTime            @default(now())

  @@unique([pmWorkId, pmPlanGroupSnapshotId])
  @@index([pmPlanId])
  @@index([pmPlanGroupSnapshotId])
}

model PmWorkAssignee {
  id           String   @id @default(cuid())
  pmWorkId     String
  pmWork       PmWork   @relation(fields: [pmWorkId], references: [id], onDelete: Restrict)
  userId       String
  user         User     @relation("PmWorkAssigneeUser", fields: [userId], references: [id], onDelete: Restrict)
  role         String
  assignedAt   DateTime @default(now())
  assignedById String?
  assignedBy   User?    @relation("PmWorkAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  @@unique([pmWorkId, userId])
  @@index([userId, role])
}

model StatusHistory {
  id          String   @id @default(cuid())
  cmWorkId    String
  cmWork      CmWork   @relation(fields: [cmWorkId], references: [id])
  fromStatus  String?
  toStatus    String
  changedById String?
  changedAt   DateTime @default(now())
  note        String?
}

model AuditEvent {
  id             String        @id @default(cuid())
  cmWorkId       String?
  cmWork         CmWork?       @relation(fields: [cmWorkId], references: [id])
  actorId        String?
  actor          User?         @relation(fields: [actorId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  plantId        String?
  plant          Plant?        @relation(fields: [plantId], references: [id])
  entityType     String
  entityId       String
  action         String
  beforeJson     String?
  afterJson      String?
  reason         String?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([plantId, createdAt])
  @@index([action, createdAt])
}

model SlaSetting {
  id            String   @id @default(cuid())
  plantId       String?  @unique
  plant         Plant?   @relation(fields: [plantId], references: [id])
  claimDays     Int      @default(1)
  executionDays Int      @default(3)
  reviewDays    Int      @default(2)
  updatedAt     DateTime @updatedAt
}

model SystemSetting {
  id                            String   @id
  plantId                       String?  @unique
  plant                         Plant?   @relation(fields: [plantId], references: [id])
  engineerWorkAssignmentEnabled Boolean  @default(false)
  updatedAt                     DateTime @updatedAt
}

model Announcement {
  id               String        @id @default(cuid())
  title            String
  content          String
  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id])
  imageFileName    String?
  imageMimeType    String?
  imageFileSize    Int?
  imageStoragePath String?
  publishStart     DateTime
  publishEnd       DateTime
  pinned           Boolean       @default(false)
  active           Boolean       @default(true)
  authorId         String
  author           User          @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([active, publishStart, publishEnd])
  @@index([pinned, publishStart])
  @@index([authorId])
}

model UserNotification {
  id           String    @id @default(cuid())
  recipientId  String
  recipient    User      @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  eventType    String
  entityType   String
  entityId     String
  targetStatus String?
  title        String
  message      String
  href         String?
  dispatchKey  String?   @unique
  createdAt    DateTime  @default(now())
  readAt       DateTime?

  @@index([recipientId, readAt, createdAt])
  @@index([recipientId, targetStatus, readAt])
  @@index([recipientId, entityType, entityId, readAt])
  @@index([entityType, entityId])
  @@index([eventType])
}

model LineDestination {
  id             String        @id @default(cuid())
  displayName    String
  targetId       String        @unique
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  plantId        String?
  plant          Plant?        @relation(fields: [plantId], references: [id])
  categoryId     String?
  category       Category?     @relation(fields: [categoryId], references: [id])
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  settings            LineEventSetting[]
  deliveries          LineDeliveryLog[]
  discovery           LineGroupDiscovery?
  dailyReportSettings LineDailyReportSetting[]

  @@index([organizationId, active])
  @@index([plantId, active])
  @@index([categoryId, active])
}

model LineEventSetting {
  id            String          @id @default(cuid())
  destinationId String
  destination   LineDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  eventType     String
  enabled       Boolean         @default(true)

  @@unique([destinationId, eventType])
}

model LineDeliveryLog {
  id            String          @id @default(cuid())
  eventId       String
  destinationId String
  destination   LineDestination @relation(fields: [destinationId], references: [id])
  eventType     String
  payloadJson   String
  status        String          @default("PENDING")
  attempts      Int             @default(0)
  errorSummary  String?
  sentAt        DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([eventId, destinationId])
  @@index([destinationId])
  @@index([status, createdAt])
}

model LineGroupDiscovery {
  id                 String           @id @default(cuid())
  groupId            String           @unique
  organizationId     String?
  organization       Organization?    @relation(fields: [organizationId], references: [id])
  displayName        String?
  eventType          String?
  firstSeenAt        DateTime         @default(now())
  lastSeenAt         DateTime         @default(now())
  addedDestinationId String?          @unique
  addedDestination   LineDestination? @relation(fields: [addedDestinationId], references: [id], onDelete: SetNull)

  @@index([organizationId, lastSeenAt])
  @@index([lastSeenAt])
}

model LineDailyReportSetting {
  id             String           @id
  organizationId String?
  organization   Organization?    @relation(fields: [organizationId], references: [id])
  plantId        String?
  plant          Plant?           @relation(fields: [plantId], references: [id])
  enabled        Boolean          @default(false)
  destinationId  String?
  destination    LineDestination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  sendTime       String           @default("08:00")
  dateMode       String           @default("YESTERDAY")
  templateJson   String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId])
  @@index([plantId])
  @@index([destinationId])
}

model OrganizationProfile {
  id              String        @id
  organizationId  String?       @unique
  organization    Organization? @relation(fields: [organizationId], references: [id])
  companyName     String
  logoFileName    String?
  logoMimeType    String?
  logoFileSize    Int?
  logoStoragePath String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model PlantProfile {
  id              String   @id
  plantId         String   @unique
  plant           Plant    @relation(fields: [plantId], references: [id])
  companyName     String?
  address         String?
  contactName     String?
  contactPhone    String?
  notes           String?
  logoFileName    String?
  logoMimeType    String?
  logoFileSize    Int?
  logoStoragePath String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model StoreCategory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  plantId        String
  plant          Plant        @relation(fields: [plantId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  stores Store[]

  @@unique([plantId, name])
  @@index([organizationId, active])
  @@index([plantId, active])
}

model Store {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  plantId        String
  plant          Plant          @relation(fields: [plantId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       StoreCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  code           String
  name           String
  location       String?
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  stocks            StoreStock[]
  movements         StockMovement[]
  receiveItems      SparePartReceiveItem[]
  issueItems        SparePartIssueItem[]
  defaultSpareParts SparePart[]

  @@unique([plantId, code])
  @@unique([plantId, name])
  @@index([organizationId, active])
  @@index([plantId, active])
  @@index([categoryId])
}

model SparePartCategory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  plantId        String
  plant          Plant        @relation(fields: [plantId], references: [id], onDelete: Cascade)
  code           String?
  name           String
  description    String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  spareParts     SparePart[]
  materialGroups SparePartMaterialGroup[]

  @@unique([plantId, name])
  @@unique([plantId, code])
  @@index([organizationId, active])
  @@index([plantId, active])
}

model SparePartMaterialGroup {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  plantId        String
  plant          Plant             @relation(fields: [plantId], references: [id], onDelete: Cascade)
  categoryId     String
  category       SparePartCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  code           String
  name           String
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  spareParts SparePart[]

  @@unique([categoryId, code])
  @@unique([categoryId, name])
  @@index([organizationId, active])
  @@index([plantId, active])
  @@index([categoryId, active])
}

model SparePartType {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  plantId        String
  plant          Plant        @relation(fields: [plantId], references: [id], onDelete: Cascade)
  code           String
  name           String
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  spareParts SparePart[]

  @@unique([plantId, code])
  @@unique([plantId, name])
  @@index([organizationId, active])
  @@index([plantId, active])
}

model SparePart {
  id              String                  @id @default(cuid())
  organizationId  String
  organization    Organization            @relation(fields: [organizationId], references: [id])
  plantId         String
  plant           Plant                   @relation(fields: [plantId], references: [id], onDelete: Cascade)
  categoryId      String?
  category        SparePartCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  materialGroupId String?
  materialGroup   SparePartMaterialGroup? @relation(fields: [materialGroupId], references: [id], onDelete: SetNull)
  typeId          String?
  type            SparePartType?          @relation(fields: [typeId], references: [id], onDelete: SetNull)
  defaultStoreId  String?
  defaultStore    Store?                  @relation(fields: [defaultStoreId], references: [id], onDelete: SetNull)
  code            String
  itemCode        String?
  itemKind        String                  @default("SPARE_PART")
  name            String
  description     String?
  unit            String
  latestUnitPrice Decimal?
  minStock        Decimal                 @default(0)
  maxStock        Decimal?
  reorderPoint    Decimal                 @default(0)
  active          Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  stocks       StoreStock[]
  movements    StockMovement[]
  receiveItems SparePartReceiveItem[]
  issueItems   SparePartIssueItem[]

  @@unique([plantId, code])
  @@unique([organizationId, itemCode])
  @@index([organizationId, active])
  @@index([plantId, active])
  @@index([plantId, itemCode])
  @@index([plantId, itemKind, active])
  @@index([categoryId, active])
  @@index([materialGroupId, active])
  @@index([typeId, active])
  @@index([defaultStoreId, active])
}

model StoreApplicableZone {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  plantId        String
  plant          Plant        @relation(fields: [plantId], references: [id], onDelete: Cascade)
  zoneId         String
  zone           Zone         @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  code           String
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([plantId, zoneId])
  @@unique([plantId, code])
  @@index([organizationId, active])
  @@index([plantId, active])
  @@index([zoneId])
}

model SparePartSequence {
  plantId    String   @id
  plant      Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)
  lastNumber Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model StoreIssueSequence {
  id         String   @id @default(cuid())
  plantId    String
  plant      Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)
  year       Int
  month      Int
  lastNumber Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([plantId, year, month])
  @@index([plantId])
}

model StoreStock {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  plantId        String
  plant          Plant        @relation(fields: [plantId], references: [id], onDelete: Cascade)
  storeId        String
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sparePartId    String
  sparePart      SparePart    @relation(fields: [sparePartId], references: [id], onDelete: Cascade)
  quantity       Decimal      @default(0)
  updatedAt      DateTime     @updatedAt

  @@unique([storeId, sparePartId])
  @@index([organizationId])
  @@index([plantId])
  @@index([sparePartId])
}

model StockMovement {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  plantId        String
  plant          Plant        @relation(fields: [plantId], references: [id], onDelete: Cascade)
  storeId        String
  store          Store        @relation(fields: [storeId], references: [id])
  sparePartId    String
  sparePart      SparePart    @relation(fields: [sparePartId], references: [id])
  actorId        String?
  actor          User?        @relation(fields: [actorId], references: [id])
  movementType   String
  refType        String?
  refId          String?
  quantityChange Decimal
  balanceAfter   Decimal?
  unitPrice      Decimal?
  note           String?
  occurredAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@index([organizationId, occurredAt])
  @@index([plantId, occurredAt])
  @@index([storeId, occurredAt])
  @@index([sparePartId, occurredAt])
  @@index([movementType, occurredAt])
  @@index([refType, refId])
  @@index([actorId])
}

model SparePartReceive {
  id             String       @id @default(cuid())
  number         String       @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  plantId        String
  plant          Plant        @relation(fields: [plantId], references: [id], onDelete: Cascade)
  receivedById   String?
  receivedBy     User?        @relation(fields: [receivedById], references: [id])
  supplierName   String?
  referenceNo    String?
  note           String?
  status         String       @default("RECEIVED")
  receivedAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  items SparePartReceiveItem[]

  @@index([organizationId, receivedAt])
  @@index([plantId, receivedAt])
  @@index([receivedById])
}

model SparePartReceiveItem {
  id          String           @id @default(cuid())
  receiveId   String
  receive     SparePartReceive @relation(fields: [receiveId], references: [id], onDelete: Cascade)
  storeId     String
  store       Store            @relation(fields: [storeId], references: [id])
  sparePartId String
  sparePart   SparePart        @relation(fields: [sparePartId], references: [id])
  quantity    Decimal
  unitPrice   Decimal?
  note        String?

  @@index([storeId])
  @@index([sparePartId])
  @@index([receiveId])
}

model SparePartIssue {
  id                   String       @id @default(cuid())
  number               String       @unique
  submissionKey        String?      @unique
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id])
  plantId              String
  plant                Plant        @relation(fields: [plantId], references: [id], onDelete: Cascade)
  cmWorkId             String?
  cmWork               CmWork?      @relation(fields: [cmWorkId], references: [id], onDelete: SetNull)
  issueType            String
  itemKind             String       @default("SPARE_PART")
  status               String       @default("WAITING_ENGINEER_APPROVAL")
  requesterName        String
  requesterDepartment  String?
  requesterContact     String?
  vehicle              String?
  odometerBefore       Decimal?
  odometerAfter        Decimal?
  dispenserMeterBefore Decimal?
  dispenserMeterAfter  Decimal?
  requesterUserId      String?
  requesterUser        User?        @relation("StoreIssueRequester", fields: [requesterUserId], references: [id], onDelete: SetNull)
  engineerId           String?
  engineer             User?        @relation("StoreIssueEngineer", fields: [engineerId], references: [id], onDelete: SetNull)
  storeOfficerId       String?
  storeOfficer         User?        @relation("StoreIssueOfficer", fields: [storeOfficerId], references: [id], onDelete: SetNull)
  note                 String?
  rejectReason         String?
  requestedAt          DateTime     @default(now())
  engineerApprovedAt   DateTime?
  issuedAt             DateTime?
  rejectedAt           DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  items SparePartIssueItem[]

  @@index([organizationId, requestedAt])
  @@index([plantId, requestedAt])
  @@index([cmWorkId])
  @@index([status, requestedAt])
  @@index([requesterUserId])
  @@index([engineerId])
  @@index([storeOfficerId])
}

model SparePartIssueItem {
  id           String         @id @default(cuid())
  lineNumber   String?
  issueId      String
  issue        SparePartIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  storeId      String?
  store        Store?         @relation(fields: [storeId], references: [id], onDelete: SetNull)
  sparePartId  String
  sparePart    SparePart      @relation(fields: [sparePartId], references: [id])
  zoneId       String?
  zone         Zone?          @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  zoneCode     String?
  requestedQty Decimal
  approvedQty  Decimal?
  issuedQty    Decimal?
  unitPrice    Decimal?
  status       String         @default("REQUESTED")
  note         String?

  @@index([storeId])
  @@index([sparePartId])
  @@index([issueId])
  @@index([zoneId])
  @@index([status])
}

model PublicFeedback {
  id             String        @id @default(cuid())
  name           String
  department     String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  plantId        String?
  plant          Plant?        @relation(fields: [plantId], references: [id])
  message        String
  sourcePath     String?
  createdAt      DateTime      @default(now())

  @@index([createdAt])
}

model AssetClass {
  id        String      @id @default(cuid())
  plantId   String
  plant     Plant       @relation(fields: [plantId], references: [id], onDelete: Cascade)
  nameTh    String
  nameEn    String?
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  types     AssetType[]
  assets    Asset[]

  @@unique([plantId, nameTh])
  @@index([plantId, active])
}

model AssetType {
  id           String                @id @default(cuid())
  plantId      String
  plant        Plant                 @relation(fields: [plantId], references: [id], onDelete: Cascade)
  assetClassId String
  assetClass   AssetClass            @relation(fields: [assetClassId], references: [id])
  code         String
  nameTh       String
  nameEn       String?
  active       Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  fields       AssetTechnicalField[]
  assets       Asset[]

  @@unique([plantId, code])
  @@index([plantId, active])
  @@index([assetClassId])
}

model AssetTechnicalField {
  id          String                @id @default(cuid())
  assetTypeId String
  assetType   AssetType             @relation(fields: [assetTypeId], references: [id], onDelete: Cascade)
  key         String
  labelTh     String
  labelEn     String?
  dataType    String                @default("TEXT")
  unit        String?
  optionsJson String?
  required    Boolean               @default(false)
  active      Boolean               @default(true)
  sortOrder   Int                   @default(0)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  values      AssetTechnicalValue[]

  @@unique([assetTypeId, key])
  @@index([assetTypeId, active, sortOrder])
}

model AssetFamily {
  id        String          @id @default(cuid())
  plantId   String
  plant     Plant           @relation(fields: [plantId], references: [id], onDelete: Cascade)
  code      String
  nameTh    String
  nameEn    String?
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  assets    Asset[]
  sequences AssetSequence[]

  @@unique([plantId, code])
  @@index([plantId, active])
}

model AssetSequence {
  id         String      @id @default(cuid())
  plantId    String
  plant      Plant       @relation(fields: [plantId], references: [id], onDelete: Cascade)
  familyId   String
  family     AssetFamily @relation(fields: [familyId], references: [id])
  lastNumber Int         @default(0)
  updatedAt  DateTime    @updatedAt

  @@unique([plantId, familyId])
}

model Asset {
  id                   String                @id @default(cuid())
  publicToken          String                @unique @default(cuid())
  plantId              String
  plant                Plant                 @relation(fields: [plantId], references: [id], onDelete: Cascade)
  familyId             String
  family               AssetFamily           @relation(fields: [familyId], references: [id])
  assetClassId         String
  assetClass           AssetClass            @relation(fields: [assetClassId], references: [id])
  assetTypeId          String?
  assetType            AssetType?            @relation(fields: [assetTypeId], references: [id])
  zoneId               String?
  zone                 Zone?                 @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  parentId             String?
  parent               Asset?                @relation("AssetHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children             Asset[]               @relation("AssetHierarchy")
  code                 String?               @unique
  sequence             Int?
  componentCode        String?
  nameTh               String
  nameEn               String?
  installationLocation String?
  manufacturer         String?
  model                String?
  serialNumber         String?
  serialNormalized     String?
  installedAt          DateTime?
  commissionedAt       DateTime?
  operatingStatus      String                @default("IN_SERVICE")
  criticality          String                @default("MEDIUM")
  registrationStatus   String                @default("ACTIVE")
  cancellationReason   String?
  imageFileName        String?
  imageMimeType        String?
  imageFileSize        Int?
  imageStoragePath     String?
  qrOverrideJson       String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  technicalValues      AssetTechnicalValue[]
  documents            AssetDocument[]
  cmWorks              CmWork[]
  pmGroups             PmGroupAsset[]
  pmWorks              PmWork[]

  @@unique([parentId, componentCode])
  @@unique([id, plantId])
  @@index([plantId, registrationStatus])
  @@index([familyId])
  @@index([assetClassId, assetTypeId])
  @@index([zoneId])
  @@index([parentId])
  @@index([serialNormalized])
}

model AssetTechnicalValue {
  id          String               @id @default(cuid())
  assetId     String
  asset       Asset                @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fieldId     String?
  field       AssetTechnicalField? @relation(fields: [fieldId], references: [id], onDelete: SetNull)
  customLabel String?
  dataType    String               @default("TEXT")
  unit        String?
  value       String?
  sortOrder   Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([assetId, fieldId])
  @@index([assetId, sortOrder])
}

model AssetDocument {
  id             String    @id @default(cuid())
  assetId        String
  asset          Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  category       String
  customCategory String?
  title          String
  revision       String?
  documentDate   DateTime?
  note           String?
  fileName       String
  mimeType       String
  fileSize       Int
  storagePath    String
  version        Int       @default(1)
  publicVisible  Boolean   @default(false)
  status         String    @default("ACTIVE")
  canceledReason String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([assetId, category, status])
}

model AssetQrSetting {
  id                String   @id @default(cuid())
  plantId           String   @unique
  plant             Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)
  showImage         Boolean  @default(true)
  showLocation      Boolean  @default(true)
  showManufacturer  Boolean  @default(true)
  showModel         Boolean  @default(true)
  showSerialNumber  Boolean  @default(false)
  showTechnical     Boolean  @default(false)
  showLastCmDate    Boolean  @default(true)
  showLastCmTitle   Boolean  @default(false)
  showLastCmOutcome Boolean  @default(false)
  showLastPmDate    Boolean  @default(true)
  showLastPmTitle   Boolean  @default(false)
  showLastPmOutcome Boolean  @default(false)
  updatedAt         DateTime @updatedAt
}
